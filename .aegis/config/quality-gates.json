{
  "schema_version": 1,
  "gates": {
    "test": {
      "command": "npm test",
      "enabled": true,
      "blocking": true,
      "description": "Run the test suite."
    },
    "typecheck": {
      "command": "npm run typecheck",
      "enabled": true,
      "blocking": true,
      "description": "Run TypeScript type checking."
    },
    "lint": {
      "command": "npm run lint",
      "enabled": true,
      "blocking": true,
      "description": "Run lint checks."
    },
    "build": {
      "command": "npm run build",
      "enabled": true,
      "blocking": true,
      "description": "Build the CLI."
    }
  }
}
