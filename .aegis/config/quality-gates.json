{
  "schema_version": 1,
  "gates": {
    "test": {
      "command": "npm test",
      "enabled": true,
      "blocking": true,
      "description": "Run the test suite."
    },
    "typecheck": {
      "command": "npm run typecheck",
      "enabled": true,
      "blocking": true,
      "description": "Run TypeScript type checking."
    },
    "lint": {
      "command": "npm run lint",
      "enabled": true,
      "blocking": true,
      "description": "Run lint checks."
    },
    "coverage": {
      "command": "npx vitest run --coverage --coverage.thresholds.lines=0 --coverage.thresholds.branches=0 --coverage.thresholds.functions=0 --coverage.thresholds.statements=0 --coverage.reporter=json-summary && node -e \"process.stdout.write(require('fs').readFileSync('coverage/coverage-summary.json','utf8'))\"",
      "enabled": true,
      "blocking": true,
      "description": "Run coverage checks.",
      "threshold": {
        "lines": 100,
        "branches": 100,
        "functions": 100,
        "statements": 100
      }
    }
  }
}
