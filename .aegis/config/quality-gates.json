{
  "schema_version": 1,
  "gates": {
    "test": {
      "command": "npm test",
      "enabled": true,
      "blocking": true,
      "description": "Run the test suite."
    },
    "typecheck": {
      "command": "npm run typecheck",
      "enabled": true,
      "blocking": true,
      "description": "Run TypeScript type checking."
    },
    "lint": {
      "command": "npm run lint",
      "enabled": true,
      "blocking": true,
      "description": "Run lint checks."
    },
    "coverage": {
      "command": "npm run coverage",
      "enabled": true,
      "blocking": true,
      "description": "Run coverage checks.",
      "threshold": {
        "lines": 100,
        "branches": 100,
        "functions": 100,
        "statements": 100
      }
    }
  }
}
